{
	// The scenario files loaded after this one, in order.
	"scenarios":["origin_scenario", "longevity_scenario", "titanic_scenario", "lusitania_scenario"],
	
	"initialOperation":"origin_story",
	
	// The sides an Agent can be on. Every Agent is in one: "unaligned" unless its data gives a
	// "faction".
	"factions":{
		"timecorps":{
			"label":"Time Corps",
			"hq":"time_corps_hq",
			"defaultAgentRole":"Agent",
			"description":"The Nexus-based service that watches the causal thread and repairs it. Its agents travel under Corps protocols, draw chronal from the HQ pool and answer to Command."
		},
		"syndicate":{
			"label":"The Syndicate",
			"hq":"syndicate_hq",
			"defaultAgentRole":"Operative",
			"description":"Time travellers who answer to no Command and keep no protocols. They change history for whoever pays them, or for reasons of their own, and the Corps has never found out who leads them."
		},
		"unaligned":{
			"label":"Unaligned",
			"defaultAgentRole":"Civilian",
			"description":"Answers to no one. Whatever they know of time travel, they learned on their own, and no one is coming to get them out."
		}
	},
	
	"skillChecks":{
		"coin_flip":{
			"name":"Coin Flip",
			"check":"agent.skills.luck",
			"difficulty":500
		},
		"sure_thing":{
			"name":"Sure Thing",
			"check":"1000",
			"difficulty":"no-roll"
		},
		"impossible":{
			"name":"Impossible",
			"check":"0",
			"difficulty":1000
		},
		"social":{
			"name":"Social",
			"check":"0.3*agent.skills.cha + 0.3*agent.skills.deception + 0.3*agent.skills.persuasion + 0.1*agent.skills.luck"
		},
		"athletic":{
			"name":"Athletic",
			"check":"0.45*agent.skills.str + 0.45*agent.skills.agl + 0.1*agent.skills.luck",
			"difficulty":175
		},
		"sneak":{
			"name":"Sneak",
			"check":"0.45*agent.skills.dex + 0.45*agent.skills.stealth + 0.1*agent.skills.luck",
			"difficulty":275
		},
		"investigate":{
			"name":"Investigate",
			"check":"(0.9*agent.skills.investigation + 0.1*agent.skills.luck) -3*event.attestation.value",
			"difficulty":200
		}
	},
	
	"skills":{
		// Misc
		"luck":{
			"name":"Luck",
			"description":"How much the hand of fate favors you."
		},
		
		// Attributes
		"agl":{
			"name":"Agility",
			"description":"Balance and coordination."
		},
		"dex":{
			"name":"Dexterity",
			"description":"Fine motor skills."
		},
		"str":{
			"name":"Strength",
			"description":"Physical prowess and brawn."
		},
		"cha":{
			"name":"Charisma",
			"description":"Your force of personality."
		},
		
		// Skills
		"chronogation":{
			"name":"Chronogation",
			"description":"The efficiencty with which an agent employs “chronal” to travel through time and space."
		},
		"investigation":{
			"name":"Investigation",
			"description":"The overall effectiveness of an agent in gaining knowledge about a historical event through examining it first hand."
		},
		"stealth":{
			"name":"Stealth",
			"description":"Avoid notice, either unseen and unheard or become simply unremarkable in a crowd."
		},
		"disguise":{
			"name":"Disguise",
			"description":"Pass as someone you are not. Can depend on props obtained elsewhere."
		},
		"deception":{
			"name":"Deception",
			"description":"Lie and interact socially without drawing suspicion."
		},
		"persuasion":{
			"name":"Persuasion",
			"description":"Through force of personality, persuade someone of an idea, concept or course of action."
		}
	},
	
	"locations":{
		"_etherium":{
			"name":"Etherium",
			"color":"#000",
			"textColor":"#fff",
			"order":0
		},
		"_nexus":{
			"name":"The Nexus",
			"color":"#000",
			"textColor":"#fff",
			"order":1
		}
	},
	
	"scratch":{
		"transfer":0, // Used when an amount needs to be calculated before it is used in multiple set/adj.
		"syndicate_hq_hidden":"true",
		"time_corps_hq_hidden":"true",
		"the_void_hidden":"true"
	},
	
	"events":{
		"the_void":{
			"name":"⦰ The Void", "hub":true, "chronoLocked":"true",
			"hidden":"scratch.the_void_hidden",
			"start":"+100000-01-01T00:00:00", "duration":{"s":0}, "location":"_etherium",
			"description":[
				"Where the Etherium puts what it can no longer place. Nothing here has direction: no gradient, no pressure, no difference for light to cross or sound to move through. Space goes on without features and time without a before or after.",
				"<br><br>The Void does not destroy. It does not consume. It waits. An agent taken by the chronovores is filed as lost, and only provisionally, because nothing that falls here has ended. It has only stopped being different from everything else."
			],
			"actions":{"_investigate":null}
		},
		"syndicate_hq":{
			"name":"❉ Syndicate Warehouse", "hub":true,
			"hidden":"scratch.syndicate_hq_hidden",
			"start":"2151-04-19T00:00:00", "duration":{"d":30}, "location":"_nexus",
			"description":[
				"A freight warehouse on the edge of the Nexus years, 2151, twenty-three years before the Corps’ own. Pallet racks screen a jump array built from stolen and salvaged parts, and the chronal tanks are filled from somewhere off every grid.",
				"<br><br>There is no duty officer and no Command, only whoever is on shift and whoever is paying. Syndicate operatives rest, train and reload here, and are recalled here when a job goes wrong."
			],
			"actionLimit":30,
			"actions":{
				"_investigate":null,
				
				// Agents can heal critical health damage here.
				"_heal":{
					"label":"Infirmary Stay",
					"available":"agent.health.value < agent.health.max",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"(agent.health.max - agent.health.value) / 2"
					},
					"adj":{
						"agent.health":{
							"onSuccess":"d(8,6)"
						}
					}
				},
				
				"_restockChronal":{
					"label":"Restock Chronal +1",
					"skillCheck":{"difficulty":"no-roll"},
					"available":"timeline.chronal.value < timeline.chronal.max",
					"costs":{
						"agent.action":null,
						"timeline.credits":"1"
					},
					"adj":{
						"timeline.chronal":{
							"onSuccess":"1"
						}
					}
				},
				
				// Agents can reload their chronal from the shared HQ pool.
				"_reloadChronal":{
					"label":"Reload Chronal +3",
					"skillCheck":{"difficulty":"no-roll"},
					"hidden":"timeline.chronal.value <= 0",
					"available":"agent.chronal.value < agent.chronal.max",
					// Takes no action, and the small amount lets the pool be shared out a little at a
					// time. The cost and the adj are the same amount: up to 3, as much as the pool
					// has and the agent has room for.
					"costs":{
						"agent.action":null,
						"timeline.chronal":"Math.min(3, agent.chronal.max - agent.chronal.value, timeline.chronal.value - timeline.chronal.min)"
					},
					"adj":{
						"agent.chronal":{
							"onSuccess":"Math.min(3, agent.chronal.max - agent.chronal.value, timeline.chronal.value - timeline.chronal.min)"
						}
					}
				},
				
				// Agents can reduce their effective age.
				"_rejuvenate":{
					"label":"Rejuvenate",
					"available":"agent.effectiveAge > timeline.cfg.AGE_MIN_EFFECTIVE",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"50"
					},
					"adj":{
						"agent.effectiveAge":{
							"onSuccess":"-5"
						}
					}
				},
				
				// Agents can be treated to remove paradox, one point at a time.
				"_stabilize":{
					"label":"Causality Stabilization Treatment",
					"available":"agent.paradox.value > 0",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"30"
					},
					"adj":{
						"agent.paradox":{
							"onSuccess":"-1"
						}
					}
				}
			}
		},
		"time_corps_hq":{
			"name":"❉ Time Corps Headquarters", "hub":true,
			"hidden":"scratch.time_corps_hq_hidden",
			"start":"2174-10-14T00:00:00", "duration":{"d":30}, "location":"_nexus",
			"description":[
				"Time Corps Headquarters, at the Nexus, in the Corps’ own year: 2174. Launch halls, the recall array, the archives where every mission’s findings are filed, and the HQ Chronal Pool that every Corps agent draws on.",
				"<br><br>A duty officer is on watch around the clock, logging each departure twice: once in the Corps’ year, and once in the year the agent is going to. Agents are recalled here to heal, train and reload their chronal before the next jump."
			],
			"actionLimit":30,
			"actions":{
				"_investigate":null,
				
				// Agents can heal critical health damage here.
				"_heal":{
					"label":"Infirmary Stay",
					"available":"agent.health.value < agent.health.max",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"(agent.health.max - agent.health.value) / 2"
					},
					"adj":{
						"agent.health":{
							"onSuccess":"d(8,6)"
						}
					}
				},
				
				"_restockChronal":{
					"label":"Restock Chronal +1",
					"skillCheck":{"difficulty":"no-roll"},
					"available":"timeline.chronal.value < timeline.chronal.max",
					"costs":{
						"agent.action":null,
						"timeline.credits":"1"
					},
					"adj":{
						"timeline.chronal":{
							"onSuccess":"1"
						}
					}
				},
				
				// Agents can reload their chronal from the shared HQ pool.
				"_reloadChronal":{
					"label":"Reload Chronal +3",
					"skillCheck":{"difficulty":"no-roll"},
					"hidden":"timeline.chronal.value <= 0",
					"available":"agent.chronal.value < agent.chronal.max",
					// Takes no action, and the small amount lets the pool be shared out a little at a
					// time. The cost and the adj are the same amount: up to 3, as much as the pool
					// has and the agent has room for.
					"costs":{
						"agent.action":null,
						"timeline.chronal":"Math.min(3, agent.chronal.max - agent.chronal.value, timeline.chronal.value - timeline.chronal.min)"
					},
					"adj":{
						"agent.chronal":{
							"onSuccess":"Math.min(3, agent.chronal.max - agent.chronal.value, timeline.chronal.value - timeline.chronal.min)"
						}
					}
				},
				
				// Agents can reduce their effective age.
				"_rejuvenate":{
					"label":"Rejuvenate",
					"available":"agent.effectiveAge > timeline.cfg.AGE_MIN_EFFECTIVE",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"50"
					},
					"adj":{
						"agent.effectiveAge":{
							"onSuccess":"-5"
						}
					}
				},
				
				// Agents can be treated to remove paradox, one point at a time.
				"_stabilize":{
					"label":"Causality Stabilization Treatment",
					"available":"agent.paradox.value > 0",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"30"
					},
					"adj":{
						"agent.paradox":{
							"onSuccess":"-1"
						}
					}
				}
			}
		}
	},
	
	// Actions every Event offers, before its own. An Event can override part of one by giving an
	// action with the same ID, e.g. "_investigate":{"skillCheck":{"difficulty":150}}, or leave one
	// out with null.
	"defaultEventActions":{
		"_investigate":{
			"label":"Investigate",
			"skillCheck":{"actionType":"investigate"},
			// Nothing left to find once the record is complete.
			"hidden":"event.attestation.value >= event.attestation.max",
			"adj":{
				// Finds more the better the check goes: 1 for a bare pass, and 1 more for every
				// 40 the check passes by, so up to 25 at best.
				"event.attestation":{
					"onSuccess":"d(Math.min(margin / 20, event.attestation.max - event.attestation.value))"
				}
			}
		},
		"_rest":{
			"label":"Rest",
			// Only Events of an hour or more are long enough to rest in.
			"hidden":"event.duration < 1000 * 60 * 60",
			// Nothing to heal at full health, so don't let an agent waste an action on it. We also
			// disable for less than 50% health since the skill check provides no benefit.
			"available":"(agent.health.value < agent.health.max) && (agent.health.value / agent.health.max) > 0.5",
			
			// Rest helps light injuries but not serious ones: hopeless at half health or less,
			// rising linearly to ensured at 90% or more.
			"skillCheck":{
				"difficulty":1000, 
				"check":"Math.round(2500 * (agent.health.value / agent.health.max)) - 1250"
			},
			"adj":{
				// A successful rest heals a d(4) per hour of the Event, up to 8 hours. With no
				// check of its own the adj follows Rest's check, so a failed rest does nothing.
				"agent.health":{
					"onSuccess":"d(4, Math.min(8, event.duration / (1000 * 60 * 60)))"
				}
			}
		}
	}
}