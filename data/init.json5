{
	// The scenario files loaded after this one, in order.
	"scenarios":["origin_scenario", "longevity_scenario", "titanic_scenario", "lusitania_scenario"],
	
	"initialOperation":"origin_story",
	// The player's own agent. Agents of other factions aren't the player's to direct, even
	// if marked playerControlled.
	"playerAgent":"ME",
	
	// Groups of actions. An action joins one with its "group", and each group is shown on a line
	// of its own, after an agent's other actions (a positive order) or before them (a negative one).
	"actionGroups":{
		"chronal_pool":{"label":"Chronal Pool", "order":1},
		"chronal":{"label":"Chronal", "order":2},
		"treatments":{"label":"Treatments", "order":3},
		"jobs":{"label":"Open Jobs", "order":4}
	},
	
	// The sides an Agent can be on. Every Agent is in one: "unaligned" unless its data gives a
	// "faction".
	"factions":{
		"timecorps":{
			"label":"Time Corps",
			"hq":"time_corps_hq",
			"defaultAgentRole":"Agent",
			"description":"The Nexus-based service that watches the causal thread and repairs it. Its agents travel under Corps protocols, draw chronal from the HQ pool and answer to Command."
		},
		"syndicate":{
			"label":"The Syndicate",
			"hq":"syndicate_hq",
			"defaultAgentRole":"Operative",
			"description":"Time travellers who answer to no Command and keep no protocols. They change history for whoever pays them, or for reasons of their own, and the Corps has never found out who leads them."
		},
		"unaligned":{
			"label":"Unaligned",
			"defaultAgentRole":"Civilian",
			"description":"Answers to no one. Whatever they know of time travel, they learned on their own, and no one is coming to get them out."
		}
	},
	
	"skillChecks":{
		"coin_flip":{
			"name":"Coin Flip",
			"check":"agent.skills.luck",
			"difficulty":500
		},
		"sure_thing":{
			"name":"Sure Thing",
			"check":"1000",
			"difficulty":"no-roll"
		},
		"impossible":{
			"name":"Impossible",
			"check":"0",
			"difficulty":1000
		},
		"social":{
			"name":"Social",
			"check":"0.3*agent.skills.cha + 0.3*agent.skills.deception + 0.3*agent.skills.persuasion + 0.1*agent.skills.luck"
		},
		"athletic":{
			"name":"Athletic",
			"check":"0.45*agent.skills.str + 0.45*agent.skills.agl + 0.1*agent.skills.luck",
			"difficulty":175
		},
		"sneak":{
			"name":"Sneak",
			"check":"0.45*agent.skills.dex + 0.45*agent.skills.stealth + 0.1*agent.skills.luck",
			"difficulty":275
		},
		"investigate":{
			"name":"Investigate",
			"check":"(0.9*agent.skills.investigation + 0.1*agent.skills.luck) -3*event.attestation.value",
			"difficulty":200
		},
		"time_travel":{
			"name":"Time Travel",
			"check":"0.75*agent.skills.chronogation + 0.25*agent.skills.luck"
		},
		"resistParadox":{
			"name":"Resist Paradox",
			"check":"0.8*agent.skills.causalStability + 0.1*agent.skills.stealth + 0.1*agent.skills.luck"
		}
	},
	
	// What can happen to an agent who pays chronal to deploy, be recalled or loop back. Not 
	// exits, even jump and pulled ones, which use their own adj. "chronal" is what it cost.
	"timeTravelAdj":{
		// Injury: a die as big as the chronal cost.
		"agent.health":{"actionType":"time_travel", "difficulty":300, "onFailure":"-d(chronal)"},
		// Premature aging: a die as big as the chronal cost, in months.
		"agent.effectiveAge":{"actionType":"time_travel", "difficulty":150, "onFailure":"d(chronal)/12"},
		// Time travel always risks the agent acquiring some paradox. Chronal use is the underlying
		// risk. It is reduced by the agent's current paradox, their causalStability and a random
		// factor. That value is then logarithmically adjusted to prevent large chronal values from
		// being a guaranteed devour.
		"agent.paradox":"Math.ceil(tc.logToBase(Math.max(1, (chronal + 1) - agent.paradox.value - (agent.skills.causalStability / 33) - (d(9,3) - 3)), 1.75))"
	},
	
	// What carries from one game to the next. Each of the player's agents lost in any game, 
	// devoured by chronovores or dead of their wounds, gives the playerAgent these skills at
	// the start of every new game, and leaves the Event they fell at haunted, in every game, by 
	// one of these hauntings under its description. Each game abandoned for a new one,
	// however it was, adds these "restarted" credits to every new game, and if the 
	// playerAgent was alive and not devoured, leaves the Event they were at glitched, by one of these
	// glitches. Each game abandoned also leaves a pocket of chronal at every Event it left
	// with paradox, other than hubs and chrono locked ones, 1 for each paradoxPerChronal 
	// paradox, rounded up, for later games to gather. The ☠ button shows it all, and clears it.
	"legacy":{
		"paradoxPerChronal":0.333,
		"devoured":{"agent.skills.causalStability":3},
		"died":{"agent.skills.luck":1},
		"restarted":{"timeline.credits":1},
		"hauntings":[
			"You feel as if you are being watched, but can’t identify the source.",
			"A spectral presence seems always just out of sight.",
			"Somewhere close by, someone breathes in time with you.",
			"The air here is colder than it has any right to be.",
			"For an instant you glimpse a familiar silhouette, and then nothing.",
			"Footsteps echo your own, half a beat behind.",
			"You catch the scent of ozone and something burnt, though nothing is burning.",
			"A voice you almost recognize whispers a warning you can’t quite make out.",
			"The shadows here pool in the shape of someone who isn’t there.",
			"This moment feels worn thin, as if something tore through it once before."
		],
		"glitches":[
			"You sense a subtle break in causality, as if someone or something was removed from reality.",
			"Your mind seems to stutter for a second and then you feel like yourself again.",
			"For a heartbeat the world around you repeats itself, exactly, and then carries on.",
			"You reach for a thought that should be here and find only its outline.",
			"You hear someone familiar start to say your name, then it stops, and you realize they aren’t even here.",
			"A light flickers once, though nothing here could make it.",
			"You have the uneasy feeling you’ve already left this place.",
			"A word on the tip of your tongue dissolves before you can say it.",
			"Everything is where it should be, and yet something is missing.",
			"The seconds here don’t quite line up, like a film poorly spliced."
		]
	},
	
	// Experience: for every month of lived age (never the body's), a skill picked by 
	// weight gains a point. The weights are out of 100 here only for readability.
	"agingSkillGains":{
		"monthsPerGain":1,
		"weights":{
			"luck":30,
			"causalStability":15,
			"chronogation":3,
			"agl":5, "dex":5, "str":4, "cha":5,
			"investigation":6, "stealth":6, "disguise":7, "deception":7, "persuasion":7
		}
	},
	
	// The phrase an exit's button starts with, by the exit's "mode", before the name of
	// where it goes. "default" is for an exit with no mode, or one not listed here.
	// "jump" and "pulled" are time travel, whatever their phrase. A later file's phrase
	// replaces an earlier one for the same mode.
	"exitModes":{
		"wait":"Wait til",
		"waitFor":"Wait for",
		"continue":"Continue to",
		"jump":"Jump to",
		"pulled":"Pulled to",
		"enter":"Enter",
		"board":"Board",
		"walk":"Walk to",
		"take":"Take",
		"swim":"Swim to",
		"bike":"Bike to",
		"lifeboat":"Lifeboat to",
		"survive":"Survive to",
		"loopback":"Loop back to",
		"default":"To"
	},
	
	// What training a skill at HQ costs, by the track an agent's "skillsByTrack" puts it on:
	// minCredits for a point near 0, and one more for every pointsPerExtraCredit the skill is
	// from 0. Skills an agent leaves out are on the default track. The dossier shows the 
	// label beside a skill on any other track.
	"skillTracks":{
		"high":{"label":"Talented", "minCredits":1, "pointsPerExtraCredit":125},
		"standard":{"label":"Standard", "default":true, "minCredits":2, "pointsPerExtraCredit":100},
		"low":{"label":"Untalented", "minCredits":3, "pointsPerExtraCredit":75}
	},
	
	"skills":{
		// Misc
		"luck":{
			"name":"Luck",
			"description":"How much the hand of fate favors you. It can’t be trained, but grows with experience.",
			"trainable":false
		},
		
		// Attributes
		"agl":{
			"name":"Agility",
			"description":"Balance and coordination."
		},
		"dex":{
			"name":"Dexterity",
			"description":"Fine motor skills."
		},
		"str":{
			"name":"Strength",
			"description":"Physical prowess and brawn."
		},
		"int":{
			"name":"Intellect",
			"description":"Raw intelligience, memory and reason."
		},
		"cha":{
			"name":"Charisma",
			"description":"Your force of personality."
		},
		
		// Skills
		"chronogation":{
			"name":"Chronogation",
			"description":"The efficiencty with which an agent employs “chronal” to travel through time and space."
		},
		"causalStability":{
			"name":"Causal Stability",
			"description":"How anchored you are to the weave of time and space. This provides a degree of protection from the predation of chronovores."
		},
		"investigation":{
			"name":"Investigation",
			"description":"The overall effectiveness of an agent in gaining knowledge about a historical event through examining it first hand."
		},
		"stealth":{
			"name":"Stealth",
			"description":"Avoid notice, either unseen and unheard or become simply unremarkable in a crowd."
		},
		"disguise":{
			"name":"Disguise",
			"description":"Pass as someone you are not. Can depend on props obtained elsewhere."
		},
		"deception":{
			"name":"Deception",
			"description":"Lie and interact socially without drawing suspicion."
		},
		"persuasion":{
			"name":"Persuasion",
			"description":"Through force of personality, persuade someone of an idea, concept or course of action."
		},
		"history":{
			"name":"History",
			"description":"Knowledge of history, at least as you remember it."
		},
		"logic":{
			"name":"Logic",
			"description":"Problem solving, mathematical reasoning and deduction."
		}
	},
	
	"locations":{
		"_etherium":{
			"name":"Etherium",
			"color":"#000",
			"textColor":"#fff",
			"order":0
		},
		"_nexus":{
			"name":"The Nexus",
			"color":"#000",
			"textColor":"#fff",
			"order":1
		}
	},
	
	"scratch":{
		"transfer":0, // Used when an amount needs to be calculated before it is used in multiple set/adj.
		"syndicate_hq_hidden":"true",
		"time_corps_hq_hidden":"true",
		"the_void_hidden":"true"
	},
	
	"events":{
		"the_void":{
			"name":"⦰ The Void", "hub":true, "chronoLocked":"true",
			"hidden":"scratch.the_void_hidden",
			"start":"+100000-01-01T00:00:00", "duration":{"s":0}, "location":"_etherium",
			"description":[
				"Where the Etherium puts what it can no longer place. Nothing here has direction: no gradient, no pressure, no difference for light to cross or sound to move through. Space goes on without features and time without a before or after.",
				"<br><br>The Void does not destroy. It does not consume. It waits. An agent taken by the chronovores is filed as lost, and only provisionally, because nothing that falls here has ended. It has only stopped being different from everything else."
			],
			"actionLimit":0,
			"actions":{"_investigate":null,"_rest":null}
		},
		"syndicate_hq":{
			"name":"❉ Syndicate Warehouse", "hub":true,
			"hidden":"scratch.syndicate_hq_hidden",
			"start":"2151-04-19T00:00:00", "duration":{"d":30}, "location":"_nexus",
			// The pool agents reload their chronal from, restocked with credits.
			"chronal":{"value":25, "max":100},
			"description":[
				"A freight warehouse on the edge of the Nexus years, 2151, twenty-three years before the Corps’ own. Pallet racks screen a jump array built from stolen and salvaged parts, and the chronal tanks are filled from somewhere off every grid.",
				"<br><br>There is no duty officer and no Command, only whoever is on shift and whoever is paying. Syndicate operatives rest, train and reload here, and are recalled here when a job goes wrong."
			],
			"actionLimit":30,
			"actions":{
				"_investigate":null,
				
				// Agents can heal critical health damage here.
				"_heal":{
					"label":"Infirmary Stay",
					"available":"agent.health.value < agent.health.max",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"(agent.health.max - agent.health.value) / 2"
					},
					"adj":{"agent.health":{"onSuccess":"d(8,6)"}}
				},
				
				"_restockChronal":{
					"label":"Restock Chronal +1",
					"group":"chronal_pool",
					"skillCheck":{"difficulty":"no-roll"},
					"available":"event.chronal.value < event.chronal.max",
					"costs":{
						"agent.action":null,
						"timeline.credits":"1"
					},
					"adj":{"event.chronal":{"onSuccess":"1"}}
				},
				
				// Agents can reload their chronal from the shared HQ pool.
				"_reloadChronal":{
					"label":"Reload Chronal +5",
					"group":"chronal_pool",
					"skillCheck":{"difficulty":"no-roll"},
					"available":"event.chronal.value > 0 && agent.chronal.value < agent.chronal.max",
					// Takes no action, and the small amount lets the pool be shared out a little at a
					// time. The cost and the adj are the same amount: up to 5, as much as the pool
					// has and the agent has room for.
					"costs":{
						"agent.action":null,
						"event.chronal":"Math.min(5, agent.chronal.max - agent.chronal.value, event.chronal.value - event.chronal.min)"
					},
					"adj":{"agent.chronal":{"onSuccess":"Math.min(5, agent.chronal.max - agent.chronal.value, event.chronal.value - event.chronal.min)"}}
				},
				
				// Agents can reduce their effective age.
				"_rejuvenate":{
					"label":"Rejuvenate",
					"group":"treatments",
					"available":"agent.effectiveAge > timeline.cfg.AGE_MIN_EFFECTIVE",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"50"
					},
					"adj":{"agent.effectiveAge":{"onSuccess":"-5"}}
				},
				
				// Agents can be treated to remove paradox, one point at a time.
				"_stabilize":{
					"label":"Causality Stabilization Treatment",
					"group":"treatments",
					"available":"agent.paradox.value > 0",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"5",
						"timeline.credits":"10"
					},
					"adj":{"agent.paradox":{"onSuccess":"-1"}}
				},
				
				"jobBoard_1":{
					"label":"Check the Job Board",
					"group":"jobs",
					"skillCheck":{"difficulty":"no-roll"},
					"hidden":"operations.titanic_noCollision.shown",
					"costs":{"agent.action":null},
					"set":{"operations.titanic_noCollision.hidden":"false"}
				}
			},
			"exits":[
				{"mode":"loopback", "to":"syndicate_hq", "allowLoopback":true}
			]
		},
		"time_corps_hq":{
			"name":"❉ Time Corps Headquarters", "hub":true,
			"hidden":"scratch.time_corps_hq_hidden",
			"start":"2174-10-14T00:00:00", "duration":{"d":30}, "location":"_nexus",
			// The pool agents reload their chronal from, restocked with credits.
			"chronal":{"value":25, "max":100},
			"description":[
				"Time Corps Headquarters, at the Nexus, in the Corps’ own year: 2174. Launch halls, the recall array, the archives where every mission’s findings are filed, and the HQ Chronal Pool that every Corps agent draws on.",
				"<br><br>A duty officer is on watch around the clock, logging each departure twice: once in the Corps’ year, and once in the year the agent is going to. Agents are recalled here to heal, train and reload their chronal before the next jump."
			],
			"actionLimit":30,
			"actions":{
				"_investigate":null,
				
				// Agents can heal critical health damage here.
				"_heal":{
					"label":"Infirmary Stay",
					"available":"agent.health.value < agent.health.max",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"(agent.health.max - agent.health.value) / 2"
					},
					"adj":{"agent.health":{"onSuccess":"d(8,6)"}}
				},
				
				"_restockChronal":{
					"label":"Restock Chronal +1",
					"group":"chronal_pool",
					"skillCheck":{"difficulty":"no-roll"},
					"available":"event.chronal.value < event.chronal.max",
					"costs":{
						"agent.action":null,
						"timeline.credits":"1"
					},
					"adj":{"event.chronal":{"onSuccess":"1"}}
				},
				
				// Agents can reload their chronal from the shared HQ pool.
				"_reloadChronal":{
					"label":"Reload Chronal +5",
					"group":"chronal_pool",
					"skillCheck":{"difficulty":"no-roll"},
					"available":"event.chronal.value > 0 && agent.chronal.value < agent.chronal.max",
					// Takes no action, and the small amount lets the pool be shared out a little at a
					// time. The cost and the adj are the same amount: up to 5, as much as the pool
					// has and the agent has room for.
					"costs":{
						"agent.action":null,
						"event.chronal":"Math.min(5, agent.chronal.max - agent.chronal.value, event.chronal.value - event.chronal.min)"
					},
					"adj":{"agent.chronal":{"onSuccess":"Math.min(5, agent.chronal.max - agent.chronal.value, event.chronal.value - event.chronal.min)"}}
				},
				
				// Agents can reduce their effective age.
				"_rejuvenate":{
					"label":"Rejuvenate",
					"group":"treatments",
					"available":"agent.effectiveAge > timeline.cfg.AGE_MIN_EFFECTIVE",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"7",
						"timeline.credits":"50"
					},
					"adj":{"agent.effectiveAge":{"onSuccess":"-5"}}
				},
				
				// Agents can be treated to remove paradox, one point at a time.
				"_stabilize":{
					"label":"Causality Stabilization Treatment",
					"group":"treatments",
					"available":"agent.paradox.value > 0",
					"skillCheck":{"difficulty":"no-roll"},
					"costs":{
						"agent.action":"5",
						"timeline.credits":"10"
					},
					"adj":{"agent.paradox":{"onSuccess":"-1"}}
				},
				
				"jobBoard_1":{
					"label":"Check the Job Board",
					"group":"jobs",
					"skillCheck":{"difficulty":"no-roll"},
					"hidden":"operations.titanic_noCollision.shown",
					"costs":{"agent.action":null},
					"set":{"operations.titanic_noCollision.hidden":"false"}
				}
			},
			"exits":[
				{"mode":"loopback", "to":"time_corps_hq", "allowLoopback":true}
			]
		}
	},
	
	// Actions every Event offers, before its own. An Event can override part of one by giving an
	// action with the same ID, e.g. "_investigate":{"skillCheck":{"difficulty":150}}, or leave one
	// out with null.
	"defaultEventActions":{
		"_investigate":{
			"label":"Investigate",
			"skillCheck":{"actionType":"investigate"},
			// Nothing left to find once the record is complete.
			"hidden":"event.attestation.value >= event.attestation.max",
			"adj":{
				// Finds more the better the check goes: 1 for a bare pass, and 1 more for every
				// 40 the check passes by, so up to 25 at best.
				"event.attestation":{
					"onSuccess":"d(Math.min(margin / 20, event.attestation.max - event.attestation.value))"
				}
			}
		},
		"_rest":{
			"label":"Rest",
			// Only Events of an hour or more are long enough to rest in.
			"hidden":"event.duration < 1000 * 60 * 60",
			// Nothing to heal at full health, so don't let an agent waste an action on it. We also
			// disable for less than 50% health since the skill check provides no benefit.
			"available":"(agent.health.value < agent.health.max) && (agent.health.value / agent.health.max) > 0.5",
			
			// Rest helps light injuries but not serious ones: hopeless at half health or less,
			// rising linearly to ensured at 90% or more.
			"skillCheck":{
				"difficulty":1000, 
				"check":"Math.round(2500 * (agent.health.value / agent.health.max)) - 1250"
			},
			"adj":{
				// A successful rest heals a d(4) per hour of the Event, up to 4 hours. With no
				// check of its own the adj follows Rest's check, so a failed rest does nothing.
				"agent.health":{
					"onSuccess":"d(4, Math.min(4, event.duration / (1000 * 60 * 60)))",
					"onFailure":"1"
				}
			}
		},
		
		// Stray chronal: an agent can gather what an Event holds into their own, or release 
		// theirs into it, a little at a time and taking no action, anywhere that isn't chrono 
		// locked.
		"_gatherChronal":{
			"label":"Gather Chronal",
			"group":"chronal",
			"skillCheck":{"actionType":"chronogation", "difficulty":50},
			"hidden":"event.chronoLocked",
			"hiddenFor":"agent.skills.chronogation <= -500",
			"available":"agent.chronal.value < agent.chronal.max",
			"costs":{
				"agent.action":null,
				"event.chronal":"1"
			},
			"adj":{"agent.chronal":{"onSuccess":"1"}}
		},
		"_releaseChronal":{
			"label":"Release Chronal",
			"group":"chronal",
			"skillCheck":{"actionType":"chronogation", "difficulty":50},
			"hidden":"event.chronoLocked",
			"hiddenFor":"agent.skills.chronogation <= -500",
			"available":"agent.chronal.value > agent.chronal.min && event.chronal.value < event.chronal.max",
			"costs":{
				"agent.action":null,
				"agent.chronal":"1"
			},
			"adj":{"event.chronal":{"onSuccess":"1"}}
		}
	}
}