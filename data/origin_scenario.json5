	"scratch":{
		"avatar_name":"", // Your name, from the avatar_name prompt.
		"avatar_photo":"avatar/AA.jpg", // Your picture's path from img/, from the avatar_photo prompt.
		"backstory_run":false,
		"backstory_guitar":false,
		"backstory_news":false,
		"backstory_work_chosen":false
	},
	
	"events":{
		"origin_alarm":{
			"name":"The Alarm", "chronoLocked":"true",
			"start":{"now":"date", "h":7}, "duration":{"h":1},
			"location":"origin_home",
			"shown":"true",
			"actionLimit":2,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"run":{
					"label":"Go for a Run",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{
						"choice":"'run'",
						"scratch.backstory_run":"true"
					},
					"adj":{
						"agent.skills.agl":{"onSuccess":"15"},
						"agent.skills.str":{"onSuccess":"10"}
					},
					"available":"!scratch.backstory_run"
				},
				"guitar":{
					"label":"Practice the Guitar",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{
						"choice":"'guitar'",
						"scratch.backstory_guitar":"true"
					},
					"adj":{
						"agent.skills.dex":{"onSuccess":"15"},
						"agent.skills.cha":{"onSuccess":"10"}
					},
					"available":"!scratch.backstory_guitar"
				},
				"news":{
					"label":"Read the News",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{
						"choice":"'news'",
						"scratch.backstory_news":"true"
					},
					"adj":{
						"agent.skills.investigation":{"onSuccess":"15"},
						"agent.skills.persuasion":{"onSuccess":"10"}
					},
					"available":"!scratch.backstory_news"
				}
			},
			"exits":[{
				"mode":"walk", "toHidden":true, "to":"origin_bus_stop",
				"hidden":"event.values.choice.flipCount < event.actionLimit",
				"set":{"events.origin_bus_stop.attestation":"1"}
			}],
			"values":{
				"choice":{
					"name":"Morning Activities",
					"value":"''",
					"description":[
						{"text":"The morning is yours, for an hour.", "shown":"event.values.choice.value === ''"},
						{"text":"Three miles along the river before breakfast, the way you do most mornings.", "shown":"scratch.backstory_run"},
						{"text":"An hour on the guitar, working at a passage you’ve never quite got.", "shown":"scratch.backstory_guitar"},
						{"text":"Coffee and the news, every word of it, with opinions.", "shown":"scratch.backstory_news"}
					]
				}
			},
			"description":[
				"Your alarm goes off at seven, the way it does every day, and the city outside your window is grey and wet and entirely ordinary.",
				"<br><br>You have an hour before the bus. Nothing about today is going to be any different from any other day.",
				{"text":"Three miles along the river before breakfast, the way you do most mornings.", "shown":"scratch.backstory_run"},
				{"text":"An hour on the guitar, working at a passage you’ve never quite got.", "shown":"scratch.backstory_guitar"},
				{"text":"Coffee and the news, every word of it, with opinions.", "shown":"scratch.backstory_news"}
			]
		},
		
		"origin_bus_stop":{
			"name":"The Bus Stop", "chronoLocked":"true",
			"imageExpr":"'origin_bus_stop' + event.values.bus.value + '.jpg'",
			"start":{"endOf":"origin_alarm", "m":3}, "duration":{"m":5},
			"location":"origin_city_streets",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"wait":{
					"label":"Wait for the Bus",
					"skillCheck":{"actionType":"coin_flip"},
					"set":{"bus":{"onSuccess":"'arrives'", "onFailure":"'late'"}}
				}
			},
			"exits":[
				{
					"mode":"board", "toHidden":true, "to":"origin_busride",
					"shown":"event.values.bus.value === 'arrives'",
					"set":{"events.origin_busride.attestation":"1"}
				},{
					"mode":"walk", "toHidden":true, "to":"origin_back_home",
					"set":{"events.origin_back_home.attestation":"1"}
				}
			],
			"values":{
				"bus":{
					"name":"Bus Arrives",
					"value":"''",
					"description":[
						{"text":"The bus seems to be running late.", "shown":"event.values.bus.value === ''"},
						{"text":"The bus arrives. You can still rush home and grab your bike if you’d rather ride to work.", "shown":"event.values.bus.value === 'arrives'"},
						{"text":"The red light in the bus shelter comes on. It indicates the bus is way behind schedule. “Why today” you think as you head home to grab your bike. You‘ll have to ride to work in the rain.", "shown":"event.values.bus.value === 'late'"}
					]
				}
			},
			"description":"The sheltered bench where folks wait for the bus. The ads are covered in grafitti and haven’t changed in months."
		},
		
		"origin_back_home":{
			"name":"Your Apartment", "title":"", "chronoLocked":"true",
			"imageExpr":"'origin_back_home_' + event.values.bike_broken.value + '.jpg'",
			"start":{"endOf":"origin_bus_stop", "m":3}, "duration":{"m":15},
			"location":"origin_home",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"repair":{
					"label":"Repair Your Bike",
					"skillCheck":{"actionType":"dex", "difficulty":350},
					"set":{"bike_broken":{"onSuccess":"false"}},
					"adj":{"agent.skills.dex":{"onSuccess":"d(4,5)"}}
				}
			},
			"values":{
				"bike_broken":{
					"name":"Bike Broken",
					"value":"true",
					"description":[
						{"text":"The chain on your bicycle is broken. You’ve got the tools to fix it but it’ll take a moment.", "shown":"event.values.bike_broken.value"},
						{"text":"Your bike works fine now, the chain has been repaired.", "hidden":"event.values.bike_broken.value"}
					]
				}
			},
			"exits":[
				{
					"mode":"walk", "toHidden":true, "to":"origin_bikeRepair",
					"shown":"event.values.bike_broken.value && event.actions.repair.attemptCount === 1",
					"set":{"events.origin_bikeRepair.attestation":"1"}
				},{
					"mode":"bike", "toHidden":true, "to":"origin_hospital",
					"hidden":"event.values.bike_broken.value",
					"set":{"events.origin_hospital.attestation":"1"},
					"adj":{"agent.skills.str":{"onBoth":"d(3)"}},
					"costs":{"agent.health":"3"}
				},{
					"mode":"bike", "toHidden":true, "to":"origin_newsroom",
					"hidden":"event.values.bike_broken.value",
					"set":{"events.origin_newsroom.attestation":"1"},
					"adj":{"agent.skills.str":{"onBoth":"d(3)"}},
					"costs":{"agent.health":"3"}
				},{
					"mode":"bike", "toHidden":true, "to":"origin_garage",
					"hidden":"event.values.bike_broken.value",
					"set":{"events.origin_garage.attestation":"1"},
					"adj":{"agent.skills.str":{"onBoth":"d(3)"}},
					"costs":{"agent.health":"3"}
				},{
					"mode":"bike", "toHidden":true, "to":"origin_theater",
					"hidden":"event.values.bike_broken.value",
					"set":{"events.origin_theater.attestation":"1"},
					"adj":{"agent.skills.str":{"onBoth":"d(3)"}},
					"costs":{"agent.health":"3"}
				}
			],
			"description":[
				"Back in your apartment, you grab your bike. You’re going to have to ride to work in this rain. Then you remember your chain broke. It’s gonna take you a few minutes to fix it.",
				{"text":"<br><br>You’ve repaired the chain. Better head out so you’re not late to work.", "hidden":"event.values.bike_broken.value"}
			]
		},
		
		"origin_bikeRepair":{
			"name":"Bike Repair", "chronoLocked":"true",
			"start":{"endOf":"origin_back_home", "m":45}, "duration":{"h":3, "m":15},
			"location":"origin_bikeshop",
			"actionLimit":0,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"repair":{
					"label":"Get Your Bike Fixed",
					"hidden":"event.actions.repair.attemptCount === 1",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"bike_broken":{"onSuccess":"false"}},
					"costs":{"agent.action":null}
				}
			},
			"values":{
				"bike_broken":{
					"name":"Bike Broken",
					"value":"true",
					"description":[
						{"text":"The bike mechanic can easily fix your chain once they’re free.", "shown":"event.values.bike_broken.value"},
						{"text":"Your bike works great now, the chain has been repaired.", "hidden":"event.values.bike_broken.value"}
					]
				}
			},
			"exits":[
				{
					"mode":"bike", "toHidden":true, "to":"origin_lunch",
					"hidden":"event.values.bike_broken.value",
					"set":{"events.origin_lunch.attestation":"1"},
					"adj":{"agent.skills.str":{"onBoth":"d(3)"}},
					"costs":{"agent.health":"2"}
				}
			],
			"description":[
				"You walk your bike to the local bike shop. The mechanic can fix it but there’s a bit of a wait.",
				{"text":"<br><br>Your bike works great now. Better get going since you’re already late for work.", "hidden":"event.values.bike_broken.value"}
			]
		},
		
		"origin_busride":{
			"name":"The Bus", "chronoLocked":"true",
			"imageExpr":"'origin_busride' + event.values.choice.value + '.jpg'",
			"start":{"endOf":"origin_bus_stop", "m":3}, "duration":{"m":40},
			"location":"origin_city_streets",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"chat":{
					"label":"Talk to Your Neighbor",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"choice":"'chat'"},
					"adj":{
						"agent.skills.cha":{"onSuccess":"10"},
						"agent.skills.persuasion":{"onSuccess":"15"}
					},
					"available":"event.values.choice.value === ''"
				},
				"watch":{
					"label":"Watch the Passengers",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"choice":"'watch'"},
					"adj":{
						"agent.skills.investigation":{"onSuccess":"10"},
						"agent.skills.disguise":{"onSuccess":"15"}
					},
					"available":"event.values.choice.value === ''"
				},
				"dodge":{
					"label":"Ride Without a Ticket",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"choice":"'dodge'"},
					"adj":{
						"agent.skills.stealth":{"onSuccess":"15"},
						"agent.skills.deception":{"onSuccess":"10"}
					},
					"available":"event.values.choice.value === ''"
				}
			},
			"exits":[
				{
					"mode":"walk", "toHidden":true, "to":"origin_hospital",
					"set":{"events.origin_hospital.attestation":"1"}
				},{
					"mode":"walk", "toHidden":true, "to":"origin_newsroom",
					"set":{"events.origin_newsroom.attestation":"1"}
				},{
					"mode":"walk", "toHidden":true, "to":"origin_garage",
					"set":{"events.origin_garage.attestation":"1"}
				},{
					"mode":"walk", "toHidden":true, "to":"origin_theater",
					"set":{"events.origin_theater.attestation":"1"}
				}
			],
			"values":{
				"choice":{
					"name":"On the Bus",
					"value":"''",
					"description":[
						{"text":"Thirty minutes of stop-and-start traffic to fill.", "shown":"event.values.choice.value === ''"},
						{"text":"You talk to the woman beside you the whole way, and by the end she’s agreed with you about everything.", "shown":"event.values.choice.value === 'chat'"},
						{"text":"You watch the other passengers and guess at their lives: how they stand, what they carry, what they’re pretending not to be.", "shown":"event.values.choice.value === 'watch'"},
						{"text":"You slip on behind a crowd at the back door, and the inspector who gets on at Fifth never looks twice at you.", "shown":"event.values.choice.value === 'dodge'"}
					]
				}
			},
			"description":[
				"The crosstown bus, crowded and steamed up, crawling through the morning traffic. The same faces as every other morning, more or less.",
				"<br><br>Where it lets you off depends on where you work."
			]
		},
		
		"origin_hospital":{
			"name":"A Grueling Shift", "chronoLocked":"true",
			"start":{"endOf":"origin_busride", "m":9}, "duration":{"h":4},
			"location":"origin_hospital",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"work":{
					"label":"Start Work",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true"},
					"adj":{
						"agent.skills.dex":{"onSuccess":"15"},
						"agent.skills.str":{"onSuccess":"10"},
						"agent.skills.deception":{"onSuccess":"-10"}
					},
					"available":"!scratch.backstory_work_chosen"
				}
			},
			"exits":[{
				"mode":"walk", "toHidden":true, "to":"origin_lunch",
				"hidden":"event.actions.work.attemptCount === 0",
				"set":{"events.origin_lunch.attestation":"1"}
			}],
			"description":[
				"You’re a nurse on the geriatric ward at St. Brendan’s: quick hands, a strong back and no patience at all for being lied to.",
				"<br><br>Eight hours of bedpans, medication rounds and small emergencies."
			]
		},
		
		"origin_lunch":{
			"name":"Lunch Break", "chronoLocked":"true", "image":"../location/origin_cafe.jpg",
			"start":{"endOf":"origin_hospital", "m":5}, "duration":{"m":50},
			"location":"origin_cafe",
			"actionLimit":2,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"meat":{
					"label":"Have the Pastrami on Rye",
					"skillCheck":{"difficulty":"no-roll"},
					"adj":{"agent.health":"3"},
					"available":"event.actions.meat.attemptCount + event.actions.veg.attemptCount === 0"
				},
				"veg":{
					"label":"Have the Lentil Soup and Salad",
					"skillCheck":{"difficulty":"no-roll"},
					"adj":{"agent.health":"3"},
					"available":"event.actions.meat.attemptCount + event.actions.veg.attemptCount === 0"
				},
				"wiki":{
					"label":"Browse Wikipedia on Your Phone",
					"skillCheck":{"difficulty":"no-roll"},
					"adj":{"agent.skills.history":"10"},
					"available":"event.actions.wiki.attemptCount + event.actions.puzzles.attemptCount === 0"
				},
				"puzzles":{
					"label":"Do Puzzles in the Paper",
					"skillCheck":{"difficulty":"no-roll"},
					"adj":{"agent.skills.logic":"10"},
					"available":"event.actions.wiki.attemptCount + event.actions.puzzles.attemptCount === 0"
				}
			},
			"exits":[{
				"mode":"walk", "toHidden":true, "to":"origin_hospital_2",
				"shown":"events.origin_hospital.actions.work.attemptCount > 0 || !scratch.backstory_work_chosen",
				"set":{"events.origin_hospital_2.attestation":"1"}
			},{
				"mode":"walk", "toHidden":true, "to":"origin_newsroom_2",
				"shown":"events.origin_newsroom.actions.work.attemptCount > 0 || !scratch.backstory_work_chosen",
				"set":{"events.origin_newsroom_2.attestation":"1"}
			},{
				"mode":"walk", "toHidden":true, "to":"origin_garage_2",
				"shown":"events.origin_garage.actions.work.attemptCount > 0 || !scratch.backstory_work_chosen",
				"set":{"events.origin_garage_2.attestation":"1"}
			},{
				"mode":"walk", "toHidden":true, "to":"origin_theater_2",
				"shown":"events.origin_theater.actions.work.attemptCount > 0 || !scratch.backstory_work_chosen",
				"set":{"events.origin_theater_2.attestation":"1"}
			}],
			"description":[
				"Fifty minutes at the Uptown Café, the same corner table as always, before it’s back to work.",
				{"text":"<br><br>The pastrami is as good as ever.", "shown":"event.actions.meat.attemptCount > 0"},
				{"text":"<br><br>The soup is hot and the salad is fresh.", "shown":"event.actions.veg.attemptCount > 0"},
				{"text":"<br><br>You lose yourself in a chain of articles about things that happened long ago.", "shown":"event.actions.wiki.attemptCount > 0"},
				{"text":"<br><br>You finish the crossword and most of the logic puzzle.", "shown":"event.actions.puzzles.attemptCount > 0"}
			]
		},
		
		"origin_hospital_2":{
			"name":"Silver Alert", "chronoLocked":"true",
			"imageExpr":"'origin_hospital_2' + event.values.choice.value + '.jpg'",
			"start":{"endOf":"origin_lunch", "m":5}, "duration":{"h":4},
			"location":"origin_hospital",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"track":{
					"label":"Track Down the Wanderer",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'track'"},
					"adj":{
						"agent.skills.investigation":{"onSuccess":"10"},
						"agent.skills.agl":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				},
				"calm":{
					"label":"Calm the Ward",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'calm'"},
					"adj":{
						"agent.skills.persuasion":{"onSuccess":"10"},
						"agent.skills.cha":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				}
			},
			"exits":[{
				"mode":"take", "toHidden":true, "to":"origin_walk_home",
				"hidden":"event.values.choice.value === ''",
				"set":{"events.origin_walk_home.attestation":"1"}
			}],
			"values":{
				"choice":{
					"name":"The Incident",
					"value":"''",
					"description":[
						{"text":"Mr. Abernathy in bed twelve has gone missing again, and the ward is getting restless.", "shown":"event.values.choice.value === ''"},
						{"text":"You find Mr. Abernathy on the roof, in his gown, looking for a bus that stopped running in 1974.", "shown":"event.values.choice.value === 'track'"},
						{"text":"Someone else finds Mr. Abernathy. You keep the rest of the ward in their beds and in good spirits.", "shown":"event.values.choice.value === 'calm'"}
					]
				}
			},
			"description":[
				"The second half of your shift is extra stressful with Mr. Abernathy going missing.",
				{"text":"<br><br>You found Mr. Abernathy on the roof, another disaster averted.", "shown":"event.values.choice.value === 'track'"},
				{"text":"<br><br>Your calm demeanor prevents the ward from descending into chaos.", "shown":"event.values.choice.value === 'calm'"}
			]
		},
		
		"origin_newsroom":{
			"name":"Deadline", "chronoLocked":"true",
			"start":{"startOf":"origin_hospital"}, "duration":{"h":4},
			"location":"origin_newsroom",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"work":{
					"label":"Start Work",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true"},
					"adj":{
						"agent.skills.investigation":{"onSuccess":"15"},
						"agent.skills.deception":{"onSuccess":"10"},
						"agent.skills.str":{"onSuccess":"-10"}
					},
					"available":"!scratch.backstory_work_chosen"
				}
			},
			"exits":[{
				"mode":"walk", "toHidden":true, "to":"origin_lunch",
				"hidden":"event.actions.work.attemptCount === 0",
				"set":{"events.origin_lunch.attestation":"1"}
			}],
			"description":[
				"You’re a reporter at the Ledger, one of the last papers in the city still printing on paper: nosy, persistent, and not above a little invention to get someone talking.",
				"<br><br>The deadline is at five. It is always at five."
			]
		},
		
		"origin_newsroom_2":{
			"name":"Chasing The Story", "chronoLocked":"true",
			"imageExpr":"'origin_newsroom_2' + event.values.choice.value + '.jpg'",
			"start":{"endOf":"origin_lunch", "m":5}, "duration":{"h":4},
			"location":"origin_newsroom",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"chase":{
					"label":"Chase the Source",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'chase'"},
					"adj":{
						"agent.skills.stealth":{"onSuccess":"10"},
						"agent.skills.deception":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				},
				"pitch":{
					"label":"Pitch the Story",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'pitch'"},
					"adj":{
						"agent.skills.persuasion":{"onSuccess":"10"},
						"agent.skills.cha":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				}
			},
			"exits":[{
				"mode":"take", "toHidden":true, "to":"origin_walk_home",
				"hidden":"event.values.choice.value === ''",
				"set":{"events.origin_walk_home.attestation":"1"}
			}],
			"values":{
				"choice":{
					"name":"The Story",
					"value":"''",
					"description":[
						{"text":"A city councilman’s name keeps turning up in places it shouldn’t, and your editor doesn’t want to hear about it.", "shown":"event.values.choice.value === ''"},
						{"text":"You follow the councilman’s aide to a parking garage and listen from behind a pillar. You have a story.", "shown":"event.values.choice.value === 'chase'"},
						{"text":"You talk your editor round, one fact at a time, until the story has the front page.", "shown":"event.values.choice.value === 'pitch'"}
					]
				}
			},
			"description":[
				"You spend the second half of your day pursuing a story.",
				{"text":"<br><br>You followed the councilman’s aide to the parking garage and got the story.", "shown":"event.values.choice.value === 'chase'"},
				{"text":"You convince your editor that your story is worth being on the front page.", "shown":"event.values.choice.value === 'pitch'"}
			]
		},
		
		"origin_garage":{
			"name":"Under the Hood", "chronoLocked":"true",
			"start":{"startOf":"origin_hospital"}, "duration":{"h":4},
			"location":"origin_garage",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"work":{
					"label":"Start Work",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true"},
					"adj":{
						"agent.skills.str":{"onSuccess":"15"},
						"agent.skills.dex":{"onSuccess":"10"},
						"agent.skills.cha":{"onSuccess":"-10"}
					},
					"available":"!scratch.backstory_work_chosen"
				}
			},
			"exits":[{
				"mode":"walk", "toHidden":true, "to":"origin_lunch",
				"hidden":"event.actions.work.attemptCount === 0",
				"set":{"events.origin_lunch.attestation":"1"}
			}],
			"description":[
				"You’re a mechanic at Delgado’s Garage: strong hands, good ears and not much to say to the customers.",
				"<br><br>The radio is on, the coffee is burnt, and there’s a car on every lift."
			]
		},
		
		"origin_garage_2":{
			"name":"The Mustang", "chronoLocked":"true", "image":"origin_garage.jpg",
			"imageExpr":"'origin_garage_2' + event.values.choice.value + '.jpg'",
			"start":{"endOf":"origin_lunch", "m":5}, "duration":{"h":4},
			"location":"origin_garage",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"fix":{
					"label":"Fix the Impossible Engine",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'fix'"},
					"adj":{
						"agent.skills.dex":{"onSuccess":"10"},
						"agent.skills.investigation":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				},
				"haggle":{
					"label":"Haggle with the Customer",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'haggle'"},
					"adj":{
						"agent.skills.persuasion":{"onSuccess":"10"},
						"agent.skills.deception":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				}
			},
			"exits":[{
				"mode":"take", "toHidden":true, "to":"origin_walk_home",
				"hidden":"event.values.choice.value === ''",
				"set":{"events.origin_walk_home.attestation":"1"}
			}],
			"values":{
				"choice":{
					"name":"The Job",
					"value":"''",
					"description":[
						{"text":"A 1968 Mustang has been towed in with a knock nobody can find, and its owner is in a hurry.", "shown":"event.values.choice.value === ''"},
						{"text":"Three hours on your back under the Mustang, and you find the knock: a cracked bolt no one else would have looked at twice.", "shown":"event.values.choice.value === 'fix'"},
						{"text":"You let the apprentice find the knock, and talk the owner into a rebuild he didn’t know he wanted.", "shown":"event.values.choice.value === 'haggle'"}
					]
				}
			},
			"description":[
				"The second half of your workday is more challenging than usual.",
				{"text":"<br><br>You fix the Mustang, finding the cracked bolt no one else would have noticed.", "shown":"event.values.choice.value === 'fix'"},
				{"text":"<br><br>You convince the Mustang’s owner to rebuild the engine.", "shown":"event.values.choice.value === 'haggle'"}
			]
		},
		
		"origin_theater":{
			"name":"The Matinee", "chronoLocked":"true",
			"start":{"startOf":"origin_hospital"}, "duration":{"h":4},
			"location":"origin_theater",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"work":{
					"label":"Start Work",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true"},
					"adj":{
						"agent.skills.disguise":{"onSuccess":"15"},
						"agent.skills.cha":{"onSuccess":"10"},
						"agent.skills.investigation":{"onSuccess":"-10"}
					},
					"available":"!scratch.backstory_work_chosen"
				}
			},
			"exits":[{
				"mode":"walk", "toHidden":true, "to":"origin_lunch",
				"hidden":"event.actions.work.attemptCount === 0",
				"set":{"events.origin_lunch.attestation":"1"}
			}],
			"description":[
				"You work at the Orpheum, an understudy who also does whatever needs doing backstage: a different face for every part, and not much interest in the details of anything else.",
				"<br><br>Two shows today, and the first is at two."
			]
		},
		
		"origin_theater_2":{
			"name":"The Show", "chronoLocked":"true", "image":"origin_theater.jpg",
			"imageExpr":"'origin_theater_2' + event.values.choice.value + '.jpg'",
			"start":{"endOf":"origin_lunch", "m":5}, "duration":{"h":4},
			"location":"origin_theater",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"cover":{
					"label":"Cover for the Lead",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'cover'"},
					"adj":{
						"agent.skills.disguise":{"onSuccess":"10"},
						"agent.skills.cha":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				},
				"rig":{
					"label":"Rig the Flying Harness",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"scratch.backstory_work_chosen":"true", "choice":"'rig'"},
					"adj":{
						"agent.skills.agl":{"onSuccess":"10"},
						"agent.skills.dex":{"onSuccess":"5"}
					},
					"available":"event.values.choice.value === ''"
				}
			},
			"exits":[{
				"mode":"take", "toHidden":true, "to":"origin_walk_home",
				"hidden":"event.values.choice.value === ''",
				"set":{"events.origin_walk_home.attestation":"1"}
			}],
			"values":{
				"choice":{
					"name":"The Show",
					"value":"''",
					"description":[
						{"text":"The lead has food poisoning, the flying rig is jammed, and curtain is at two.", "shown":"event.values.choice.value === ''"},
						{"text":"You go on in the lead’s wig and costume, and not one person in the house can tell.", "shown":"event.values.choice.value === 'cover'"},
						{"text":"You climb into the fly loft and free the jammed rig with minutes to spare, forty feet above the stage.", "shown":"event.values.choice.value === 'rig'"}
					]
				}
			},
			"description":[
				"The latter half of your day presents a unique opportunity.",
				{"text":"<br><br>You perform the lead role flawlessly.", "shown":"event.values.choice.value === 'cover'"},
				{"text":"<br><br>You heroically free the jammed rig saving the pivotal scene of the show.", "shown":"event.values.choice.value === 'rig'"}
			]
		},
		
		"origin_walk_home":{
			"name":"The Long Way Home", "chronoLocked":"true", "image":"../location/origin_street.jpg",
			"start":{"endOf":"origin_hospital_2", "m":20}, "duration":{"m":15},
			"location":"origin_street",
			"actionLimit":0,
			"actions":{"_investigate":null,"_rest":null},
			"exits":[
				{
					"mode":"walk", "toHidden":true, "to":"origin_walkHome_alley",
					"set":{"events.origin_walkHome_alley.attestation":"1"},
					"adj":{"agent.skills.stealth":{"onBoth":"10"}, "agent.skills.agl":{"onBoth":"5"}},
				},{
					"mode":"walk", "toHidden":true, "to":"origin_walkHome_helpTourist",
					"set":{"events.origin_walkHome_helpTourist.attestation":"1"},
					"adj":{"agent.skills.cha":{"onBoth":"10"}, "agent.skills.investigation":{"onBoth":"5"}},
				},{
					"mode":"walk", "toHidden":true, "to":"origin_walkHome_freeDrink",
					"set":{"events.origin_walkHome_freeDrink.attestation":"1"},
					"adj":{"agent.skills.deception":{"onBoth":"10"}, "agent.skills.persuasion":{"onBoth":"5"}},
				}
			],
			"description":"Halsey Street, the long way home, under a drizzle that can’t make up its mind. The shops are closing and the streetlights are coming on.<br><br>It’s dark already, and it’s started to rain properly."
		},
		"origin_walkHome_alley":{
			"name":"The Alley", "chronoLocked":"true", "image":"../location/origin_street_alley.jpg",
			"start":{"endOf":"origin_walk_home"}, "duration":{"m":15},
			"location":"origin_street_alley",
			"actionLimit":0,
			"actions":{"_investigate":null,"_rest":null},
			"exits":[{
				"mode":"wait", "toHidden":true, "to":"origin_stranger",
				"set":{"events.origin_stranger.attestation":"1"},
				"adj":{"events.origin_stranger.paradox":"1"}
			}],
			"description":"You cut through the alley behind the laundromat, the way you always tell yourself you shouldn’t."
		},
		"origin_walkHome_helpTourist":{
			"name":"Help a Lost Tourist", "chronoLocked":"true", "image":"../location/origin_street_hotel.jpg",
			"start":{"endOf":"origin_walk_home"}, "duration":{"m":15},
			"location":"origin_street_hotel",
			"actionLimit":0,
			"actions":{"_investigate":null,"_rest":null},
			"exits":[{
				"mode":"wait", "toHidden":true, "to":"origin_stranger",
				"set":{"events.origin_stranger.attestation":"1"},
				"adj":{"events.origin_stranger.paradox":"1"}
			}],
			"description":"A couple with a soaked paper map are lost three streets from their hotel. You walk them there and find out their whole life story."
		},
		"origin_walkHome_freeDrink":{
			"name":"Talk Your Way into a Free Drink", "chronoLocked":"true", "image":"../location/origin_street_anchor.jpg",
			"start":{"endOf":"origin_walk_home"}, "duration":{"m":15},
			"location":"origin_street_anchor",
			"actionLimit":0,
			"actions":{"_investigate":null,"_rest":null},
			"exits":[{
				"mode":"wait", "toHidden":true, "to":"origin_stranger",
				"set":{"events.origin_stranger.attestation":"1"},
				"adj":{"events.origin_stranger.paradox":"1"}
			}],
			"description":"You stop at the Anchor, and the new bartender believes every word about it being your birthday."
		},
		
		// Act 2: the encounter.
		"origin_stranger":{
			"name":"The Stranger", "chronoLocked":"true",
			"imageExpr":"'origin_stranger' + event.values.reaction.value + '.jpg'",
			"start":{"endOf":"origin_walkHome_alley", "m":2}, "duration":{"m":3},
			"location":"origin_street",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"catch":{
					"label":"Catch Them",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"reaction":"'caught'"},
					"shown":"event.values.reaction.value === ''",
					"adj":{"agent.chronal":{"onSuccess":"1"}}
				},
				"back":{
					"label":"Step Back",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"reaction":"'backed'"},
					"shown":"event.values.reaction.value === ''",
					"adj":{"agent.chronal":{"onSuccess":"1"}}
				}
			},
			"exits":[{
				"mode":"wait", "toHidden":true, "to":"origin_masked",
				"hidden":"event.values.reaction.value === ''",
				"set":{"events.origin_masked.attestation":"1"},
				"adj":{"events.origin_masked.paradox":"2"}
			}],
			"values":{
				"reaction":{
					"name":"Your Reaction",
					"value":"''",
					"description":[
						{"text":"The stranger lurches toward you.", "shown":"event.values.reaction.value === ''"},
						{"text":"You catch them as they fall, and their blood is warm on your hands.", "shown":"event.values.reaction.value === 'caught'"},
						{"text":"You step back, but not fast enough. They catch your arm as they fall.", "shown":"event.values.reaction.value === 'backed'"}
					]
				}
			},
			"description":[
				"There’s a sound like a held breath let go, and a person is standing on the pavement in front of you who was not there a moment ago.",
				"<br><br>They are old, older than anyone you know, in clothes cut in a way you have never seen. Around their wrist is something that isn’t a watch and isn’t a phone, and above it, for an instant, hangs a diagram made of light: lines, branching and rejoining. Then it’s gone, and you’re not sure you saw it at all.",
				{"text":"<br><br>The stranger seizes your wrist. Something cold snaps shut around it. “You have to finish it,” they say, and their voice is strangely familiar. “My mission. Everything depends on it. Causality itself.” Then you see the blood soaking through their coat, and they fold up onto the wet pavement at your feet.", "hidden":"event.values.reaction.value === ''"}
			]
		},
		
		"origin_masked":{
			"name":"The Masked Figure", "chronoLocked":"true",
			"imageExpr":"'origin_masked' + event.values.response.value + '.jpg'",
			"start":{"endOf":"origin_stranger"}, "duration":{"m":1},
			"location":"origin_street",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"dive":{
					"label":"Dive for Cover",
					"skillCheck":{"actionType":"athletic","difficulty":600},
					"set":{"response":{"onBoth":"'dove'"}},
					"adj":{
						"agent.health":{"onSuccess":"-1","onFailure":"-d(6)"},
						"agent.skills.agl":{"onSuccess":"d(4)","onFailure":"1"},
					},
					"shown":"event.values.response.value === ''"
				},
				"stand":{
					"label":"Stand Your Ground",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"response":"'stood'"},
					"shown":"event.values.response.value === ''"
				}
			},
			"exits":[{
				"mode":"pulled", "toHidden":true, "to":"safehouse_arrival",
				"hidden":"event.values.response.value === ''",
				"set":{"events.safehouse_arrival.attestation":"1"},
				"costs":{
					"agent.chronal":"1",
					"agent.health":"d(4)"
				}
			}],
			"values":{
				"response":{
					"name":"Your Response",
					"value":"''",
					"description":[
						{"text":"The gun comes up.", "shown":"event.values.response.value === ''"},
						{"text":"You throw yourself behind a parked car, and skin your hands on the wet road.", "shown":"event.values.response.value === 'dove'"},
						{"text":"You don’t move. You couldn’t if you wanted to.", "shown":"event.values.response.value === 'stood'"}
					]
				}
			},
			"description":[
				"The air tears again. A second figure stands over the body: masked, in a close-fitting black suit that seems to swallow the streetlight. They draw something from their hip that can only be a weapon, though it is no gun you have ever seen.",
				"<br><br>On your wrist, the device begins to flash and to beep, faster and faster.",
				{"text":"<br><br>The masked figure raises the weapon. And then there is no street, no rain, no time, no you.", "hidden":"event.values.response.value === ''"}
			]
		},
		
		// Act 3: a safe house, late in the 2080s. Hidden until the device is on your wrist.
		"safehouse_arrival":{
			"name":"Elsewhere", "chronoLocked":"true",
			"imageExpr":"'safehouse_arrival' + event.values.concealed.value + '.jpg'",
			"start":"2087-03-09T23:41:00", "duration":{"m":10},
			"location":"safehouse_corridor",
			"actionLimit":1,
			"actions":{
				"_investigate":null,
				"_rest":null,
				"hide":{
					"label":"Find Somewhere to Hide",
					"skillCheck":{"actionType":"sneak"},
					"set":{"concealed":"true"},
					"hidden":"event.values.concealed.value"
				}
			},
			"exits":[{
				"mode":"wait", "toHidden":true, "to":"safehouse_fight",
				"hidden":"event.actions.hide.attemptCount === 0",
				"set":{"events.safehouse_fight.attestation":"1"},
				"adj":{"events.safehouse_fight.paradox":"2"}
			}],
			"values":{
				"concealed":{
					"name":"Concealed",
					"value":"false",
					"description":[
						{"text":"You’re crouched in the open, in plain sight of the glass.", "hidden":"event.values.concealed.value"},
						{"text":"You’ve squeezed in behind a tall cabinet, where you can see through the glass without being seen.", "shown":"event.values.concealed.value"}
					]
				}
			},
			"description":[
				"You come back to yourself on your hands and knees on a cold floor, retching. A long corridor, dimly lit, with a wall of frosted glass along one side. The air smells of dust and machine oil.",
				"<br><br>Beyond the glass is an office, and in it, arguing in low, furious voices, are the two people you just saw on Halsey Street. The old one is not bleeding. Not yet."
			]
		},
		
		"safehouse_fight":{
			"imageExpr":"'safehouse_fight' + event.attestation.value + '.jpg'",
			"name":"The Fight", "chronoLocked":"true",
			"start":"2087-03-09T23:51:00", "duration":{"m":2},
			"location":"safehouse_office",
			"actionLimit":2,
			"actions":{
				"_rest":null,
				"_investigate":{
					"label":"Watch the Two Figures",
					"skillCheck":{"difficulty":"no-roll"},
					"adj":{"event.attestation":"5"}
				}
			},
			"exits":[{
				"mode":"enter", "toHidden":true, "to":"safehouse_room",
				"hidden":"event.actions._investigate.attemptCount === 0",
				"set":{"events.safehouse_room.attestation":"1"}
			}],
			"description":[
				"The argument turns into a fight, fast and ugly. The masked figure has a blade, thin and dark, and the old one is slower than they used to be.",
				"<br><br>The blade goes in. The old one gasps, slaps at their wrist,",
				{"text":"shoots a quick glance in your direction,","shown":"events.safehouse_arrival.values.concealed.value"},
				"and is gone, in a flicker and a sound like a held breath let go.",
				{"text":"<br><br>The masked figure stands very still. Then they pass their own wrist over the place where the old one stood, slowly, back and forth, as if reading something written on the air.", "shown":"event.attestation.value > 1"},
				{"text":"They turn to look at you as they activate the device on their wrist.","shown":"!events.safehouse_arrival.values.concealed.value && event.attestation.value > 1"},
				{"text":"A moment later, they too are gone.", "shown":"event.attestation.value > 1"},
				{"text":"<br><br>You step closer to the door to the office where the fight occurred. As you do so, the device on your wrist hums and the glass door slides open.", "shown":"event.attestation.value > 6"}
			]
		},
		
		"safehouse_room":{
			"image":"../location/safehouse_office.jpg",
			"name":"The Empty Room",
			"start":{"endOf":"safehouse_fight", "m":1}, "duration":{"m":45},
			"location":"safehouse_office",
			"actionLimit":3,
			"actions":{
				"_rest":null,
				"_investigate":{
					"label":"Examine the Room",
					"skillCheck":{"difficulty":50}
				},
				"desk":{
					"label":"Search the Desk",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"foundBadge":"true"},
					"available":"!event.values.foundBadge.value",
					"costs":{"agent.action":null}
				},
				"screen":{
					"label":"Wake the Screen",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{"readScreen":"true"},
					"available":"!event.values.readScreen.value",
					"costs":{"agent.action":null}
				}
			},
			"values":{
				"foundBadge":{
					"name":"The Badge",
					"value":"false",
					"description":[
						{"text":"The desk is a mess of papers and dead hardware.", "hidden":"event.values.foundBadge.value"},
						{"text":"Under the papers is a badge: a disc of dark glass that lights at your touch. A circle, two arrows chasing each other around it, and the words TIME CORPS · FIELD AGENT. The name beneath has been scratched out.", "shown":"event.values.foundBadge.value"}
					]
				},
				"readScreen":{
					"name":"The Screen",
					"value":"false",
					"description":[
						{"text":"A screen on the wall is dark.", "hidden":"event.values.readScreen.value"},
						{"text":"The screen wakes to the date, 9 March 2087, and to a diagram you have seen once before, over a stranger’s wrist: lines of light, branching and rejoining, one of them pulsing red.", "shown":"event.values.readScreen.value"}
					]
				}
			},
			"exits":[{
				"mode":"waitFor", "toHidden":true, "to":"safehouse_room_message",
				"shown":"event.values.foundBadge.value && event.values.readScreen.value",
				"set":{"events.safehouse_room_message.attestation":"1"}
			}],
			"description":[
				"The office is empty now. A chair is overturned, and there’s blood on the floor where the old one stood, and a faint scorch mark in a circle around it.",
				{"text":"<br><br>It isn’t an office, exactly. There’s a cot in one corner, tins of food, spare clothes, a go-bag by the door. Someone has been living here, and hiding.", "hidden":"event.attestation.value < 10"},
				{"text":"<br><br>Taped inside a cupboard door is a hand-drawn chart of dates: 1912, 1915, 1588, 1453, and dozens more, each with notes beside it in a cramped hand. The handwriting is very like your own.", "hidden":"event.attestation.value < 25"},
				{"text":"<br><br>In a drawer, a sheaf of printouts: personnel files from something called the Corps, its agents scattered across a thousand years. One is stamped DECEASED. Another is stamped COMPROMISED. Several faces have been circled.", "hidden":"event.attestation.value < 40"}
			]
		},
		
		"safehouse_room_message":{
			"image":"../location/safehouse_office.jpg",
			"name":"The Message",
			"start":{"endOf":"safehouse_room"}, "duration":{"m":5},
			"location":"safehouse_office",
			"actionLimit":2,
			"actions":{
				"_rest":null,
				"_investigate":null,
				"answer":{
					"label":"Touch the Icon on the Device",
					"skillCheck":{"difficulty":"no-roll"},
					"set":{
						"heard":"true",
						"agent.chronal":{"onSuccess":"20"},
						"agent.skills.chronogation":{"onSuccess":"-500"}
					},
					"available":"!event.values.heard.value"
				},
				"restAMoment":{
					"label":"Rest a Moment",
					"skillCheck":{"difficulty":"no-roll"},
					"adj":{"agent.health":"150"},
					"shown":"event.values.heard.value"
				}
			},
			"values":{
				"heard":{
					"name":"Message Heard",
					"value":"false",
					"description":[
						{"text":"The device on your wrist is flashing, insistently. Should you activate it?", "hidden":"event.values.heard.value"},
						{"text":"You’ve listened to the message, and it seems you now have a mission.", "shown":"event.values.heard.value"}
					]
				}
			},
			"description":[
				"You linger in the office, unsure how to proceed. A faint sound drifts in from the corridor. You turn toward the door, ready to head back out and follow it, when the device on your wrist grows warm. A few seconds later it chimes once, and a green icon, something like a play button, begins to flash on its surface.",
				{"text":"<br><br>A figure made of light rises from the device: the old stranger, unhurt, a recording looking straight at you. “If you’re seeing this, I didn’t make it, and the device has chosen you. I’m sorry. There isn’t time to explain, and you wouldn’t believe me if I did.<br><br>“The Corps is compromised. Someone inside is pulling threads, and history is starting to come apart. The thread they’re pulling now runs through Shanghai, on the twelfth of November 2087: the day the world learns it no longer has to grow old.<br><br>“Go and watch. Find out how it happened, and who made it happen. Don’t touch anything, at least not yet. The device will take you there. As for who to trust: no one.<br><br>“You can do this. I know you can, better than anyone.”<br><br>The figure flickers, gives you a smile you almost recognize, and is gone.", "shown":"event.values.heard.value"}
			]
		}
	}
}
