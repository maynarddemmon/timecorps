{
	"prompts":{
		"avatar_name":{
			"type":"text",
			"title":"Yesterday’s Mail",
			"description":"You turn on the coffee maker and go through the mail from yesterday. A few bills and some credit card offers, all made out to you:",
			"input":{
				"scratch":"avatar_name",
				"maxLength":25,
				"allowedChars":"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZàáâãäåæçèéêëìíîïñòóôõöøùúûüýÿÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕÖØÙÚÛÜÝ -'’.",
				"placeholder":"Your name"
			},
			"buttons":{
				"confirm":{"label":"That’s Me"}
			}
		},
		
		"avatar_photo":{
			"type":"image",
			"title":"Your Photo",
			"description":"You take a quick glance in the mirror to make sure everything is in order before you head out. You don’t think anyone will notice, or care, about that grease stain on your pants. Who do you see staring back at you in the mirror?",
			"input":{
				"scratch":"avatar_photo",
				"images":[
					"avatar/AA.jpg", "avatar/AB.jpg", "avatar/AC.jpg", "avatar/AD.jpg", "avatar/AE.jpg", "avatar/AF.jpg", "avatar/AG.jpg", "avatar/AH.jpg",
					"avatar/AI.jpg", "avatar/AJ.jpg", "avatar/AK.jpg", "avatar/AL.jpg", "avatar/AM.jpg", "avatar/AN.jpg", "avatar/AO.jpg", "avatar/AP.jpg",
					"avatar/AQ.jpg", "avatar/AR.jpg", "avatar/AS.jpg", "avatar/AT.jpg", "avatar/AU.jpg", "avatar/AV.jpg", "avatar/AW.jpg", "avatar/AX.jpg",
					"avatar/AY.jpg", "avatar/AZ.jpg", "avatar/BA.jpg", "avatar/BB.jpg", "avatar/BC.jpg", "avatar/BD.jpg", "avatar/BE.jpg", "avatar/BF.jpg",
					"avatar/BG.jpg", "avatar/BH.jpg", "avatar/BI.jpg", "avatar/BJ.jpg", "avatar/BK.jpg", "avatar/BL.jpg", "avatar/BM.jpg", "avatar/BN.jpg",
					"avatar/BO.jpg", "avatar/BP.jpg", "avatar/BQ.jpg", "avatar/BR.jpg", "avatar/BS.jpg", "avatar/BT.jpg", "avatar/BU.jpg", "avatar/BV.jpg",
					"avatar/BW.jpg", "avatar/BX.jpg", "avatar/BY.jpg", "avatar/BZ.jpg", "avatar/CA.jpg", "avatar/CB.jpg", "avatar/CC.jpg", "avatar/CD.jpg",
					"avatar/CE.jpg", "avatar/CF.jpg", "avatar/CG.jpg", "avatar/CH.jpg", "avatar/CI.jpg", "avatar/CJ.jpg", "avatar/CK.jpg", "avatar/CL.jpg",
					"avatar/CM.jpg", "avatar/CN.jpg", "avatar/CO.jpg", "avatar/CP.jpg", "avatar/CQ.jpg", "avatar/CR.jpg", "avatar/CS.jpg", "avatar/CT.jpg",
					"avatar/CU.jpg", "avatar/CV.jpg", "avatar/CW.jpg", "avatar/CX.jpg", "avatar/CY.jpg", "avatar/CZ.jpg"
				]
			},
			"buttons":{
				"confirm":{"label":"Looks Great!"}
			}
		}
	},
	
	"operations":{
		"origin_story":{
			"title":"Origin Story",
			"name":"A Day Like Any Other",
			"description":[],
			"onSetup":{
				"awardAgents":"player",
				"revealAgents":"player",
				"initialAgentSelection":"player",
				"initialEventSelection":"origin_alarm",
				"set":{
					"events.origin_alarm.historicity":"5"
				},
				"promptEarly":["avatar_name", "avatar_photo"]
			},
			"objectives":{
				"answer":{
					"name":"Answer the Call",
					"description":"Find out what has happened to you.",
					"success":"events.safehouse_room_message.values.heard.value && player.event === events.safehouse_room_message.id && player.health.value === player.health.max"
				}
			},
			"onSuccess":{
				"debrief":[
					"Yesterday you were an ordinary person with an ordinary life. Tonight you are alone in a stranger’s hideout, sixty years from home, with a dead agent’s mission strapped to your wrist.",
					"<br><br>You don’t know who the old stranger was, or who the masked figure is, or what the Time Corps wants with you. You know one thing: in Shanghai, in November 2087, something is about to change the world, and someone wants it to."
				],
				"nextOperation":"spring_witness",
				"adj":{
					"timeline.score":"1000"
				}
			}
		}
	},
	
	"locationsBaseOrder":25,
